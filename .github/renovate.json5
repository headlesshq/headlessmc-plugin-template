{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [":enableRenovate", ":semanticCommits", "config:best-practices"],
  timezone: "UTC",
  dependencyDashboard: true,
  platformCommit: "enabled",
  prCreation: "not-pending",
  rebaseWhen: "conflicted",
  suppressNotifications: ["prIgnoreNotification"],
  // Only the managers below are used.
  enabledManagers: ["gradle", "gradle-wrapper", "github-actions", "git-submodules", "devcontainer"],
  // Commit types matter: release-please turns `fix(deps)` into a release.
  packageRules: [
    { matchUpdateTypes: ["major"], addLabels: ["dependency/major"] },
    { matchUpdateTypes: ["minor"], addLabels: ["dependency/minor"] },
    { matchUpdateTypes: ["patch"], addLabels: ["dependency/patch"] },
    {
      matchManagers: ["gradle"],
      semanticCommitType: "fix",
      semanticCommitScope: "deps",
    },
    {
      matchManagers: ["gradle-wrapper"],
      semanticCommitType: "build",
      semanticCommitScope: "deps",
    },
    {
      matchManagers: ["github-actions"],
      semanticCommitType: "ci",
      semanticCommitScope: "deps",
    },
    {
      // follows the `branch` configured in .gitmodules, all submodules in one PR
      matchManagers: ["git-submodules"],
      semanticCommitType: "build",
      semanticCommitScope: "deps",
      groupName: "git submodules",
    },
    {
      matchManagers: ["devcontainer"],
      semanticCommitType: "build",
      semanticCommitScope: "deps",
    },
  ],
  "git-submodules": {
    enabled: true,
  },
}
